# /etc/qe-agent.env 示例（0600）。
#
# 两个角色（node / machine）共用同一张设备证书与同一个数据目录：
# - node：镜像下发、策略拉取、transfer 上报；
# - machine：机器遥测（两档采集 + mTLS 上报）。
#
# 先用管理端房间页签发的注册链接完成注册（一次性）：
#   qe-agent enroll "<link>" --trust
# 注册成功后本文件里的 DEVICE_SLOT / DEVICE_DATA_DIR / DEVICE_PKI_MTLS_URL 保持不变即可。

# ---- 身份（mTLS，两个角色都用）----
DEVICE_PKI_MTLS_URL=https://<room-node>:4441
DEVICE_SLOT=room-101
DEVICE_DATA_DIR=/var/lib/qe-agent

# ---- 角色：node ----
# 本地策略优先级：内置默认 < agent-config.json < 显式 env < 远端 /agent/config。
# 可选的本地策略文件：AGENT_CONFIG_FILE=/var/lib/qe-agent/agent-config.json
# LXC_AUTO_START=false
# DOWNLOAD_CONCURRENCY=4
# CACHE_MAX_BYTES=10737418240
# POLL_INTERVAL_SECS=2

# ---- 角色：machine ----
# 遥测上报默认走 mTLS；bearer 仅用于旧服务端过渡。
# REPORT_MODE=mtls
# 两档频率的默认值来自服务端（room 默认 + 单机覆盖）；这里只做本机兜底覆盖。
# ROOM_AGENT_FAST_INTERVAL_SECS=10
# ROOM_AGENT_FULL_INTERVAL_SECS=300
# 外部工具路径（默认走 PATH；内网离线环境建议指到 /opt/qe/bin/）
# PLATFORM_HEALTH_BIN=/opt/qe/bin/platform-health
# PLATFORM_DIAGNOSE_BIN=/opt/qe/bin/platform-diagnose
# QEAUDIT_BIN=/opt/qe/bin/qeaudit
# 只采内置指标时打开（减少子机权限要求）
# ROOM_AGENT_DISABLE_HEALTH=true
# ROOM_AGENT_DISABLE_DIAGNOSE=true
# ROOM_AGENT_DISABLE_SECURITY=true
# ROOM_AGENT_DISABLE_DOCKER=true
# ROOM_AGENT_DISABLE_VMS=true
