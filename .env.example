# 复制为 .env 后按需修改：cp .env.example .env
# 生产环境务必替换 JWT_SECRET、POSTGRES_PASSWORD、BOOTSTRAP_ADMIN_PASSWORD。

# ---- 服务 ----
# development（默认）或 production。production 会拒绝示例密钥、示例数据库密码和通配 CORS。
APP_ENV=development
BIND_ADDR=0.0.0.0:8080
HTTP_PORT=8080
RUST_LOG=info,sqlx=warn
LOG_FORMAT=pretty

# ---- 对象存储（S3 兼容：RustFS / MinIO / Ceph）----
# 同时设置 S3_ENDPOINT 与 S3_BUCKET 才会启用资源/镜像模块；否则相关接口返回 503。
# 本地 cargo run 用 127.0.0.1；容器（compose）里用 http://rustfs:9000
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ENDPOINT_DOCKER=http://rustfs:9000
# S3_REGION=us-east-1
# S3_BUCKET=qestudio
# S3_ACCESS_KEY=rustfsadmin
# S3_SECRET_KEY=rustfsadmin
# S3_PATH_STYLE=true
# STORAGE_PRESIGN_TTL_SECONDS=900
# 32 字节 Ed25519 seed 的 base64；留空则启动时随机生成（仅开发）。
# STORAGE_SIGNING_KEY_BASE64=

# ---- 设备注册（device-pki）----
# 设备注册服务对外地址，用于房间「生成注册 token」时返回注册链接。
PUBLIC_ENROLL_ENDPOINT=https://localhost:4440

# ---- 数据库 / 缓存 ----
# 本地 cargo run 使用 localhost；compose 会覆盖为容器内地址。
DATABASE_URL=postgres://qestudio:qestudio@localhost:5432/qestudio
REDIS_URL=redis://localhost:6379
DB_MAX_CONNECTIONS=10

POSTGRES_DB=qestudio
POSTGRES_USER=qestudio
POSTGRES_PASSWORD=qestudio
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- 限流 / 缓存 ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCK_SECONDS=900
# 同一 IP 的登录尝试上限（滑动窗口，成功登录也计数）
LOGIN_IP_MAX_ATTEMPTS=60
LOGIN_IP_WINDOW_SECONDS=300
# 找回密码/邮箱验证的发送上限
EMAIL_RATE_LIMIT_MAX=5
EMAIL_RATE_LIMIT_WINDOW_SECONDS=900
ANNOUNCEMENT_CACHE_SECONDS=30

# ---- 课表事件引擎 ----
# 是否启动后台触发/投递任务；多副本时靠 Redis 锁保证同一轮只有一个副本执行。
SCHEDULE_ENGINE_ENABLED=true
# 触发扫描与投递周期（秒）
SCHEDULE_TICK_SECONDS=15
# 排课实例物化窗口（天）
SCHEDULE_HORIZON_DAYS=30
# 全量重建周期（秒）
SCHEDULE_REBUILD_INTERVAL_SECONDS=3600
# 事件实时广播频道
SCHEDULE_PUBSUB_CHANNEL=qe-schedule:events
# 房间设备下行通知频道（与 device-pki 的 NOTIFY_REDIS_CHANNEL 保持一致）
SCHEDULE_DOWNLINK_NOTIFY_CHANNEL=qe-device-pki:downlink
# Webhook 单次超时（秒）
SCHEDULE_WEBHOOK_TIMEOUT_SECONDS=5
# Webhook / 下行最大投递尝试次数
SCHEDULE_WEBHOOK_MAX_ATTEMPTS=5
# 每轮最多处理的到期投递数
SCHEDULE_DELIVERY_BATCH=50

# ---- 账号安全 ----
# 前端找回密码/邮箱验证链接的前缀
PUBLIC_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_TTL_SECONDS=86400
# log（开发）或 smtp
EMAIL_DRIVER=log
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=QEStudio <no-reply@qestudio.local>

# ---- 认证 ----
# 生成：openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ---- 引导管理员（仅当用户不存在时创建）----
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# ---- Web ----
# 逗号分隔；填 * 表示允许任意来源（仅建议本地开发使用）。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 生产镜像（compose.prod.yaml 使用）----
# BACKEND_IMAGE=registry.example.com/team/backend:latest

# ---- 镜像覆盖（可选，内网/离线环境用本地镜像）----
# POSTGRES_IMAGE=postgres:18.4-alpine
# REDIS_IMAGE=redis:7-alpine
# NGINX_IMAGE=nginx:1.31-alpine
# RUST_IMAGE=rust:1.97-bookworm
# RUNTIME_IMAGE=debian:bookworm-slim

# ---- 可选：Grafana 可观测性（--profile observability）----
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_PORT=3000
# LOKI_PORT=3100
# ALLOY_PORT=12345
# 内网镜像站可覆盖：
# LOKI_IMAGE=grafana/loki:3.6.2
# ALLOY_IMAGE=grafana/alloy:v1.21.2
# GRAFANA_IMAGE=grafana/grafana:13.2.5

# ---- 可选：OpenTelemetry trace 导出 ----
# 留空关闭；指向 OTLP/HTTP collector（默认 http://otel-collector:4318）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=qestudio-backend
# OTEL_LOGS_ENABLED=true

# 设备在线状态 webhook 通知（qe-api 侧扫描 device_session）
# 投递目标回退链：rooms.webhook_url → areas.webhook_url → 全局 URL
# DEVICE_PRESENCE_ENABLED=true
# DEVICE_PRESENCE_TICK_SECONDS=5
# DEVICE_PRESENCE_WEBHOOK_TIMEOUT_SECONDS=5
# DEVICE_PRESENCE_NOTIFY_ONLINE=false
# DEVICE_PRESENCE_GLOBAL_WEBHOOK_URL=
# DEVICE_PRESENCE_WEBHOOK_MAX_ATTEMPTS=5
# DEVICE_PRESENCE_WEBHOOK_BATCH=20
# DEVICE_PRESENCE_RETRY_BASE_SECONDS=5

# 管理端实时流（SSE）与事件/投递查询使用 GET /api/v1/admin/device-events
# 与 /api/v1/admin/device-presence-deliveries，无需额外配置；Nginx 反代需关闭缓冲：
# proxy_buffering off;
# proxy_read_timeout 3600s;

# ---- 机器遥测（room-agent 子机器端）----
# 机器上报模式：mtls（默认，设备证书，走 device-pki 的 POST /machine/report）
# 或 bearer（兼容旧部署，走 qe-api 的 POST /api/v1/machine/report）。
# REPORT_MODE=mtls
# mTLS 模式：device-pki mTLS 端点 + 槽位；证书在 <DEVICE_DATA_DIR>/creds/<DEVICE_SLOT>。
# DEVICE_PKI_MTLS_URL=https://localhost:4441
# DEVICE_SLOT=
# DEVICE_DATA_DIR=./data
# 两档采集间隔（秒）。服务端 agent_configs 可下发覆盖（global→area→room→device）。
# fast：只采内置指标，5..=60，默认 10；full：含外部工具，60..=3600，默认 300。
# ROOM_AGENT_FAST_INTERVAL_SECS=10
# ROOM_AGENT_FULL_INTERVAL_SECS=300
# Bearer 模式（REPORT_MODE=bearer）才需要（过渡兼容，新部署不需要）：
# 机器上报 Bearer token；至少 16 字符。留空 = 关闭 POST /api/v1/machine/report（503）。
# 生成：openssl rand -hex 24
MACHINE_AGENT_TOKEN=
# 每台机器保留的快照条数（10-1000）。
MACHINE_SNAPSHOT_KEEP=100

# ---- 工单自动建单 worker（P0）----
# 总开关：默认 true。关闭后仍可人工建单/处理，只是不再自动生成规则工单。
TICKETS_AUTO_ENABLED=true
# 扫描间隔（秒），10..=600，默认 60。
TICKET_TICK_SECONDS=60
# 设备离线判定阈值（分钟），1..=1440，默认 10（教室正常关机可能误报，可调大）。
TICKET_DEVICE_OFFLINE_MINUTES=10
# 机器健康连续非 ok 快照条数，1..=10，默认 2（过滤 10s 档抖动）。
TICKET_HEALTH_CONSECUTIVE=2
# 课表投递失败回看窗口（小时），1..=168，默认 24。
TICKET_LOOKBACK_HOURS=24
# 说明：worker 首轮只建基线，不重放历史问题；去重依赖 DB 部分唯一索引，
# 多副本并发安全，不依赖 Redis 锁。审计 action：ticket.create/assign/status/comment。

# ---- 工单 P1：独立细粒度权限 / 规则配置 / 超时提醒 ----
# 工单邮件通知开关（转派通知、超时提醒）；未配置 SMTP 时走 log driver，默认 true。
TICKET_EMAIL_ENABLED=true
# 同一工单超时提醒的最小间隔（小时），1..=168，默认 24。
TICKET_OVERDUE_REMIND_HOURS=24
# 说明：自动建单规则在「运维 → 自动规则」页面维护（ticket_rules 表），
# 上面的 TICKET_DEVICE_OFFLINE_MINUTES / TICKET_HEALTH_CONSECUTIVE / TICKET_LOOKBACK_HOURS
# 只作为规则缺失时的兜底默认值。

# 工单附件代理上传需要 20MiB + 余量
MAX_BODY_BYTES=26214400
